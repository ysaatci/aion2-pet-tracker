<Window x:Class="AionMeter.App.Windows.PetOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nearby pets" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="12">
    <Border x:Name="Panel" CornerRadius="8" BorderBrush="{StaticResource GoldDim}" BorderThickness="1"
            Padding="10,7,10,8" MinWidth="240" MaxWidth="340">
        <Border.Background>
            <SolidColorBrush Color="{StaticResource Bg0Color}" Opacity="0.82" />
        </Border.Background>
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <Grid>
            <!-- Nearby soul sources grouped by genus; header rows and pet rows share one list -->
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1,0,1" Background="Transparent" ToolTip="{Binding Tip}">
                            <TextBlock Text="{Binding Header}" Visibility="{Binding HeaderVisibility}" Foreground="{Binding Accent}"
                                       FontSize="10.5" FontWeight="Bold" Margin="0,4,0,1" />
                            <Grid Visibility="{Binding RowVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="{Binding NameBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{StaticResource TextMute}"
                                           FontFamily="{StaticResource NumberFont}" FontSize="11" Margin="6,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Level}" Foreground="{Binding Accent}" FontWeight="SemiBold"
                                           FontFamily="{StaticResource NumberFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <Grid Grid.Column="3" Height="15" VerticalAlignment="Center">
                                    <Border Background="{StaticResource RowTrack}" CornerRadius="3" />
                                    <Border Background="{Binding Accent}" CornerRadius="3" Opacity="0.55" HorizontalAlignment="Left"
                                            Width="{Binding FillWidth}" />
                                    <TextBlock Text="{Binding Souls}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="{StaticResource NumberFont}" FontSize="10.5" FontWeight="SemiBold" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextMute}" FontSize="11.5" Margin="2,2,2,1" />
        </Grid>
    </Border>
</Window>
