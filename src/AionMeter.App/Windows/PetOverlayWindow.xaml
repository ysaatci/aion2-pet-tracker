<Window x:Class="AionMeter.App.Windows.PetOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nearby pets" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="11.5">
    <Window.Resources>
        <!-- The × on a row: invisible until the row is hovered -->
        <Style x:Key="RemoveButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMute}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Visibility" Value="Hidden" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Width="14" Height="14">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid, AncestorLevel=2}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="Panel" CornerRadius="6" Padding="9,6,6,6" Width="232" BorderThickness="1" BorderBrush="#14FFFFFF">
        <Border.Background>
            <SolidColorBrush x:Name="PanelFill" Color="{StaticResource Bg0Color}" Opacity="0.55" />
        </Border.Background>
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <StackPanel>
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Row: genus dot · name · count · souls, a hairline progress bar under it -->
                        <Grid Background="Transparent" Margin="0,2,0,3" ToolTip="{Binding Tip}" Opacity="{Binding RowOpacity}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="11" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="6" Height="6" Fill="{Binding Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="{StaticResource TextDim}" Opacity="0.7" FontSize="10"
                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Souls}" Foreground="{StaticResource TextDim}"
                                           FontFamily="{StaticResource NumberFont}" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <Button Grid.Column="4" Style="{StaticResource RemoveButton}" HorizontalAlignment="Right"
                                        Click="Remove_Click" ToolTip="{Binding RemoveTip}" />
                            </Grid>
                            <Grid Grid.Row="1" Height="2" Margin="11,3,16,0" Visibility="{Binding BarVisibility}">
                                <Border Background="#1AFFFFFF" CornerRadius="1" />
                                <Border Background="{Binding Accent}" CornerRadius="1" HorizontalAlignment="Left" Width="{Binding FillWidth}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextMute}" FontSize="10.5" Margin="1,1,1,1" />
            <TextBlock x:Name="MoreText" Foreground="{StaticResource TextMute}" FontSize="10"
                       Margin="11,1,0,0" />
        </StackPanel>
    </Border>
</Window>
