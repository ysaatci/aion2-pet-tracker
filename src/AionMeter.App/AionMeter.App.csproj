<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AionMeter.Core\AionMeter.Core.csproj" />
    <ProjectReference Include="..\PetTracker.Core\PetTracker.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AION2PetTracker</AssemblyName>
    <RootNamespace>AionMeter.App</RootNamespace>
    <Product>AION2 Pet Tracker</Product>
    <AssemblyTitle>AION2 Pet Tracker</AssemblyTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms both define Application, MessageBox, Brush... keep WinForms explicit (tray icon only). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Development runs read data\ next to the program; the published single exe carries it embedded (DataFiles). -->
    <None Include="..\..\data\**\*" Link="data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="..\..\data\**\*" Exclude="..\..\data\NOTICE.md" LogicalName="data/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
